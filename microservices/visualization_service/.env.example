# ============================================================
# GenoNexus Visualization Service — Environment Configuration
# ============================================================

# Server
PORT=4500
NODE_ENV=development

# External Service URLs (read-only consumption)
GENOMICS_API_URL=http://localhost:8000
ML_API_URL=http://localhost:8001
COLLABORATION_API_URL=http://localhost:8002

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# Security
JWT_SECRET=genonexus-viz-jwt-secret-change-in-production
API_KEY=genonexus-viz-api-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=100

# Logging
LOG_LEVEL=info
